{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Re-Anime",
  "version": "0.1.0",
  "identifier": "com.reanime.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Re:Anime Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700,
        "backgroundColor": "#101117"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/characters/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
