{
  "schema_version": "1.0",
  "package_id": "reze",
  "version": "0.3.3",
  "name": "Reze",
  "display_name": "Reze",
  "description": "Layered Re:Anime character package with body pose states, combined eye-and-eyebrow face states, and mouth states.",
  "author": "User-edited assets",
  "canvas": {
    "width": 1024,
    "height": 1024,
    "color_space": "RGBA",
    "background": "transparent"
  },
  "rig": {
    "type": "state_compositor",
    "layers": [
      {
        "id": "body",
        "type": "pose_state",
        "required": true,
        "assets": [
          "body/Standee.png",
          "body/arm crossed.png",
          "body/cheerful.png",
          "body/fashion.png",
          "body/neutral.png",
          "body/peace sign.png",
          "body/pointing.png",
          "body/shy.png",
          "body/thinking.png",
          "body/waving.png"
        ]
      },
      {
        "id": "headGroup",
        "type": "container",
        "required": true,
        "children": [
          "head",
          "face",
          "mouth"
        ]
      },
      {
        "id": "head",
        "type": "base_art",
        "required": true,
        "assets": [
          "head/head.png"
        ]
      },
      {
        "id": "face",
        "type": "expression_state",
        "required": true,
        "composition": "eyes_and_eyebrows_combined",
        "assets": [
          "face/angry_side_glance.png",
          "face/closed.png",
          "face/closed_blush.png",
          "face/hal_closed_blush.png",
          "face/half_closed.png",
          "face/normal_open.png",
          "face/skeptical.png",
          "face/sleepy_half_closed.png",
          "face/surperised.png",
          "face/wink.png",
          "face/worried.png",
          "face/serious.png",
          "face/angry.png"
        ]
      },
      {
        "id": "mouth",
        "type": "mouth_state",
        "required": true,
        "assets": [
          "mouth/laugh.png",
          "mouth/neutral.png",
          "mouth/open.png",
          "mouth/round.png",
          "mouth/shout.png",
          "mouth/small_open.png",
          "mouth/smile.png",
          "mouth/tongue_out.png"
        ]
      }
    ],
    "notes": [
      "Body PNGs are complete body/pose states, including the arms and hands drawn in each pose.",
      "Face PNGs contain eyes and eyebrows together; they do not contain the head, hair, or mouth.",
      "Mouth PNGs contain mouth artwork only.",
      "The head layer includes the head and hair artwork supplied in this package."
    ]
  },
